# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend URLs)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────
# Use a long random string in production — e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Default admin account (created by `npm run seed`) ───────────────────────
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@nasiekus.co.ke
ADMIN_PASSWORD=change-this-password

# ── M-Pesa / Safaricom Daraja API ────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke (create an app under your sandbox)
MPESA_ENV=sandbox
# sandbox: https://sandbox.safaricom.co.ke  |  production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Sandbox test shortcode is 174379 — replace with your Paybill/Till in production
MPESA_SHORTCODE=174379
# Sandbox passkey is published on the Daraja docs "Lipa na M-Pesa Online" page
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# Must be a public HTTPS URL Safaricom can reach — use ngrok in local dev,
# e.g. https://abcd1234.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-url/api/mpesa/callback
